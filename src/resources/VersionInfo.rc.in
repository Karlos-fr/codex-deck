// ============================================================================
// Codex Glass - Modele des metadonnees de version Windows
// ----------------------------------------------------------------------------
// Ce fichier est configure par CMake pour produire la ressource VERSIONINFO de
// l'executable. La source de verite est `project(VERSION ...)` dans CMakeLists.
// ============================================================================

#include <winver.h>

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@CODEX_GLASS_VERSION_BUILD@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@CODEX_GLASS_VERSION_BUILD@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName", "@CODEX_GLASS_VERSION_COMPANY@"
            VALUE "FileDescription", "@PROJECT_DESCRIPTION@"
            VALUE "FileVersion", "@CODEX_GLASS_FILE_VERSION_STRING@"
            VALUE "InternalName", "CodexGlass"
            VALUE "LegalCopyright", "@CODEX_GLASS_VERSION_COPYRIGHT@"
            VALUE "OriginalFilename", "CodexGlass.exe"
            VALUE "ProductName", "Codex Glass"
            VALUE "ProductVersion", "@CODEX_GLASS_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
